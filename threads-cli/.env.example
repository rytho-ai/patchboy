# Copy to .env and fill in. .env is gitignored — never commit real values.

# Threads-specific App ID/Secret from your Meta app's "Threads" use case
# (https://developers.facebook.com/apps/ → your app → Threads → Settings).
# Distinct from the parent Facebook app's own App ID/Secret. Run `threads
# setup` for the full one-time walkthrough.
THREADS_APP_ID=
THREADS_APP_SECRET=

# Optional overrides (sane defaults shown):
# Must exactly match the https redirect URI you registered in the Threads
# use case's settings. Meta does not allow a localhost/loopback redirect.
# THREADS_REDIRECT_URI=https://localhost/
# THREADS_SESSION_PATH=~/.threads-cli/session.json
