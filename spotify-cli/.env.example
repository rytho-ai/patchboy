# Copy to .env and fill in. .env is gitignored — never commit real values.

# Public Client ID of your Spotify Dashboard app (https://developer.spotify.com/dashboard).
# NOT a secret — PKCE sends no client_secret. Register redirect URI http://127.0.0.1/callback (portless).
SPOTIFY_CLIENT_ID=

# Optional overrides (sane defaults shown):
# SPOTIFY_SESSION_PATH=~/.spotify-cli/session.json
# SPOTIFY_REDIRECT_PORT=8878
