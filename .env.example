# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Unlike spotify-cli there is NO required credential here: the developer token
# is fetched automatically from the public music.apple.com web player. The only
# per-user secret is the media-user-token, and that is normally supplied via the
# `apple-music login` paste flow (stored in the session), not here.

# Optional: catalog storefront (2-letter country). Default "us". Governs which
# regional catalog `search`/`song`/... query. Your account's own storefront is
# used automatically once you're logged in.
# APPLE_MUSIC_STOREFRONT=us

# Optional: inject a media-user-token via env instead of `apple-music login`
# (handy for agents/CI). Precedence: real env > project .env > ~/.apple-music-cli/.env.
# APPLE_MUSIC_USER_TOKEN=

# Optional overrides (sane defaults shown):
# APPLE_MUSIC_SESSION_PATH=~/.apple-music-cli/session.json
