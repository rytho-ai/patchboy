# youtube-cli config. Copy to .env and fill in.
#
# Only two commands need this: `search --api` (filtered/trending search) and
# `comments` (youtube-toolkit has no no-API fallback for comments). Every
# other command (search's default path, info, transcript, analyze, download)
# works with no key at all.
#
# Get a key: Google Cloud Console → APIs & Services → Credentials
#   → Create Credentials → API key, then enable "YouTube Data API v3"
#   for that project. Free tier: 10,000 quota units/day (search ≈ 100/call,
#   comments ≈ 1/call).
YOUTUBE_API_KEY=

# (optional) Default download folder. Default: ~/Downloads/youtube
# YOUTUBE_DOWNLOAD_DIR=~/Downloads/youtube
