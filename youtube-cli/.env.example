# youtube-cli config. Copy to .env and fill in.
#
# Only two commands need this: `search --api` (filtered/trending search) and
# `comments` (youtube-toolkit has no no-API fallback for comments). Every
# other command (search's default path, info, transcript, analyze, download)
# works with no key at all.
#
# Get a key: Google Cloud Console → APIs & Services → Credentials
#   → Create Credentials → API key, then enable "YouTube Data API v3"
#   for that project. Free tier: 10,000 quota units/day (search ≈ 100/call,
#   comments ≈ 1/call).
YOUTUBE_API_KEY=

# (optional) Default download folder. Default: ~/Downloads/youtube
# YOUTUBE_DOWNLOAD_DIR=~/Downloads/youtube

# ── Reading YOUR OWN account (my-channel/my-playlists/subscriptions) ──
# These use OAuth, not the API key. One-time setup: register a Desktop-app
# OAuth client in Google Cloud Console (run `youtube setup` for step-by-step),
# download its client_secrets.json, and point this at it. Then `youtube login`.
# YOUTUBE_OAUTH_CLIENT_SECRETS=~/.youtube-cli/client_secrets.json

# (optional) Where the saved OAuth token lives. Default: ~/.youtube-cli/token.json
# YOUTUBE_OAUTH_TOKEN_PATH=~/.youtube-cli/token.json

# ── Network policy for official Data API calls (rarely needed) ──
# Socket timeout in seconds; 0 disables the timeout. Default: 30
# YOUTUBE_REQUEST_TIMEOUT_SEC=30
# Retries for transient transport failures (SSL / connection reset) —
# quota and auth errors are never retried. Default: 1
# YOUTUBE_TRANSPORT_RETRIES=1
