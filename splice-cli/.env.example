# splice-cli config. Copy to .env and edit if you want to override defaults.
# There are NO credentials here: Splice's login is Cloudflare-Turnstile-gated,
# so a human logs into splice.com by hand in their browser once, and the
# toolkit lifts that session. See docs/reconnaissance.md.

# (optional) Where to cache the lifted session. Default: ~/.splice-cli/session.json
# SPLICE_SESSION_PATH=~/.splice-cli/session.json

# (optional) Default download folder for previews / samples.
# SPLICE_DOWNLOAD_DIR=~/Downloads/splice

# (optional) Make `download`/`buy` print the sample's splice.com listen link
# (+ price, for `buy`) and ask before proceeding, by default. Off (automatic)
# if unset — a human who wants this can also opt in per-call with --confirm
# without setting this. Set to true/1/yes to turn it on globally.
# SPLICE_CONFIRM_BEFORE_DOWNLOAD=false
